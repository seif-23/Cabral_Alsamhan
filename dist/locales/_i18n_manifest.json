    {
        "key": "faq.q1.question",
        "text": "What is EB2 NIW?",
        "file": "index.html",
        "context": "<span>What is EB2 NIW?</span>"
    },
    {
        "key": "faq.q1.answer1",
        "text": "The EB2 National Interest Waiver (NIW) is an employment-based immigration category, inviting exceptional professionals to pursue a U.S. green card without the need for employer sponsorship, if it aligns with U.S. interests.",
        "file": "index.html",
        "context": "<p>The EB2 National Interest Waiver (NIW) is an employment-based...</p>"
    },
    {
        "key": "faq.q1.link_text",
        "text": "For Verification: Please click here to verify credentials with USCIS.",
        "file": "index.html",
        "context": "<a href=\"https://www.uscis.gov\">For Verification: Please click here...</a>"
    },
    {
        "key": "faq.q2.question",
        "text": "How does AI refine the application journey?",
        "file": "index.html",
        "context": "<span>How does AI refine the application journey?</span>"
    },
    {
        "key": "faq.q2.answer",
        "text": "Our AI tools thoroughly analyze datasets of successful applications, provide alerts for potential challenges, and fortify application strengths — always under the watchful eye of Judge Alsamhan's expertise.",
